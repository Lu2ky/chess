%% ============================================================================
%% FLOWCHART - Game Flow (Main Loop)
%% ============================================================================

```mermaid
flowchart TD
    subgraph Init[Inicialización]
        A[Cargar config + perfil] --> B[Nueva partida\nnuevo()]
        B --> C[Reset chess.js\nConfigurar reloj + modo]
        C --> D[Render inicial\nrender()]
    end
    
    subgraph UserTurn[Turno Usuario]
        D --> E{Modo 2 jugadores\nO usuario = turno?}
        E -->|Sí| F[Esperar click/arrastre\nclick() / drag]
        E -->|No| EngineTurn
        F --> G{Jugada legal?}
        G -->|No| F
        G -->|Sí| H[play(mv)]
    end
    
    subgraph PlayAnalysis[Análisis Jugada]
        H --> I[busy=true, clockOn=false]
        I --> J[Ejecutar jugada\ng.move(m)]
        J --> K[Deshacer + Analizar\nscoreAll(3) + classify()]
        K --> L[Clasificar: Genial..Fallo\n+ causa + mejor jugada]
        L --> M[Re-ejecutar jugada real\nsetAdv() + log.push()]
        M --> N[render() + Actualizar UI]
    end
    
    subgraph CheckEnd[Verificar Fin]
        N --> O{over()?}
        O -->|Jaque mate| P[finish(ganador, 'Jaque mate')]
        O -->|Tablas| Q[finish(null, 'Tablas')]
        O -->|Continúa| R{Modo?}
    end
    
    subgraph EngineTurn[Turno Motor]
        R -->|Práctica/Reloj| S[reply()]
        S --> T[busy=true]
        T --> U[engineMove()\nMinimax + ID]
        U --> V[Ejecutar + setAdv()]
        V --> W[render()]
        W --> X{over()?}
        X -->|Sí| P
        X -->|No| Y[clockOn=true + busy=false]
        Y --> D
    end
    
    subgraph Clock[Reloj - cada 200ms]
        Z[setInterval] --> AA{clockOn && !ended?}
        AA -->|Sí| AB[Restar dt a turno actual]
        AB --> AC{t <= 0?}
        AC -->|Sí| AD[finish(opp, 'Tiempo')]
        AC -->|No| AE[clk() actualiza UI]
        AE --> Z
    end
    
    subgraph PostGame[Post-partida]
        P --> AF[done=true + save()]
        Q --> AF
        AF --> AG[Calcular stats\ncalc()]
        AG --> AH[Guardar en perfil\nlocalStorage]
        AH --> AI[Mostrar botón 'Ver informe']
    end
    
    style Init fill:#e8f5e9
    style UserTurn fill:#fff3e0
    style PlayAnalysis fill:#e3f2fd
    style CheckEnd fill:#fce4ec
    style EngineTurn fill:#f3e5f5
    style Clock fill:#e0f2f1
    style PostGame fill:#f1f8e9
```

%% ============================================================================
%% FLOWCHART - Engine Search (Minimax + Iterative Deepening)
%% ============================================================================

```mermaid
flowchart TD
    subgraph EngineMove[engineMove()]
        A[scoreAll(depth)] --> B[Iterative Deepening\nd=1..depth]
        B --> C[Para cada d:\n  hist={}\n  ms=movimientos legales\n  ordenar por hist + capturas]
        C --> D[Para cada movimiento:\n  qg=300\n  g.move(m)\n  s=-nm(d-1,-inf,+inf)\n  g.undo()]
        D --> E[Retornar array {m,s}\nordenado por score]
    end
    
    subgraph Negamax[nm(d,a,b)]
        F{d==0?} -->|Sí| G[qs(a,b,QD)]
        F -->|No| H[ms=movimientos\nordenar por hist]
        H --> I[Para cada m:\n  g.move(m)\n  s=-nm(d-1,-b,-a)\n  g.undo()]
        I --> J{s>=b?}
        J -->|Sí| K[hist[key]+=d*d\nreturn b]
        J -->|No| L{s>a? a=s}
        L --> M[return a]
    end
    
    subgraph Quiescence[qs(a,b,k)]
        N{c=in_check?} -->|Sí| O[ms=solo capturas/evasiones]
        N -->|No| P[s=ev()\nstand-pat\nif s>=b return b\nif s>a a=s]
        P --> O
        O --> Q{k<=0 or qg<=0?}
        Q -->|Sí| R[return c?ev():a]
        Q -->|No| S[qg--\nfiltrar capturas/promos\nordenar]
        S --> T[Para cada m:\n  poda delta si !c\n  g.move(m)\n  v=-qs(-b,-a,k-1)\n  g.undo()]
        T --> U{v>=b? return b\nv>a? a=v}
        U --> V[return a]
    end
    
    subgraph Evaluation[ev()]
        W[Recorrer tablero 8x8] --> X[Material base V[]]
        X --> Y[Bonus centralidad\nC=3.5-max(|r-3.5|,|c-3.5|)]
        Y --> Z[Bonus peones\n(p.color==w?6-r:r-1)*4]
        Z --> AA[Suma con signo\nw:+ b:-]
        AA --> AB[return turn==w?s:-s]
    end
    
    subgraph Classify[classify(all,pm)]
        AC[best=max(all.s)\nloss=clamp(best-pm.s)] --> AD{loss<=15 && pieza mayor\n  colgada?}
        AD -->|Sí| AE[Genial]
        AD -->|No| AF{En libro BK?}
        AF -->|Sí| AG[Libro]
        AF -->|No| AH[Tabla umbrales:\n<=10 Excelente\n<=40 Bueno\n<=100 Inexactitud\n<=250 Error\n>250 Fallo]
        AH --> AI[cause() detecta:\nMate, pieza colgada,\ncaptura perdida, táctica]
        AI --> AJ[Retornar {label,loss,m,best,bm,cs}]
    end
    
    style EngineMove fill:#e8f5e9
    style Negamax fill:#fff3e0
    style Quiescence fill:#e3f2fd
    style Evaluation fill:#fce4ec
    style Classify fill:#f3e5f5
```

%% ============================================================================
%% SEQUENCE DIAGRAM - Lord AI Analysis Flow
%% ============================================================================

```mermaid
sequenceDiagram
    participant U as Usuario
    participant UI as UI Layer
    participant Lord as LordAI
    participant Claude as window.claude
    participant Chess as chess.js
    participant State as Game State
    
    U->>UI: Click "Lord" en jugada / Tab Lord
    UI->>Lord: openLord(i) / send(q)
    Lord->>State: ctxMove(l) o ctxGame()
    State->>Chess: fenAt(ply) / g.fen() / g.pgn()
    Chess-->>State: FEN / PGN
    State-->>Lord: Contexto formateado
    Lord->>Claude: sample(messages, {cache:false, onText})
    Note over Lord,Claude: INSTR + contexto + pregunta
    Claude-->>Lord: Stream chunks
    Lord->>UI: addMsg('a', texto parcial)
    Lord->>Lord: Parse <<FUTUROS>> JSON
    Lord->>Lord: setFuturos() -> validar FEN + jugadas
    Lord->>UI: drawH() - render holograma
    UI->>U: Respuesta + botones futuros + tablero holograma
    
    alt Usuario navega futuros
        U->>UI: Click ◀ ▶ ⏵ en holograma
        UI->>Lord: drawH() con hk actualizado
        Lord->>Chess: Simular FEN base + jugadas
        Chess-->>Lord: Tableros resultantes
        Lord->>UI: Actualizar tablero holograma + lista jugadas
    end
```

