%% Chess Trainer - Flowchart
%% Settings / Configuration Flow

flowchart TD
    A["Click gear"] --> B["openSet()"]
    B --> C{"Render SP modal con details por seccion"}
    C --> D["UI array define 5 secciones + presets"]
    
    subgraph Sections [Secciones]
        D --> E["Tablero Presets PB + controles"]
        D --> F["Piezas Presets PP + colores/outline/size"]
        D --> G["Interfaz Tema, fuente, compacto, toggles"]
        D --> H["Botones Estilo, acento, color, tamano, sombra"]
        D --> I["Juego Sonido, vib, hold, flip, defaults"]
        D --> J["Sprites Upload PNG por pieza Copy/clear"]
        D --> K["Mis ajustes Save/load named presets"]
        D --> L["Datos Defaults, reset, export/import"]
    end
    
    subgraph Controls [Tipos Control ctl]
        M["Color picker"] --> N["data-k=lc/dc/hl/ac/wc/bc/wo/bo/bcol"]
        O["Checkbox"] --> P["data-k=co/mvd/sh/cp/bar/cap/lst/opn/snd/vib/flip/bacc/bsh/bbold/bacc"]
        Q["Range"] --> R["data-k=ps/fz/hold/brad/bpad/d_elo/d_tm/d_inc"]
        S["Select"] --> T["data-k=th/bst/d_col/d_mode"]
    end
    
    subgraph Events [Eventos SP]
        U["input/change"] --> V{"data-sp?"}
        V -->|Si| W["FileReader Image Canvas toDataURL CF.sp[key] rf()"]
        V -->|No| X["CF[key]=value sv() ap() if flip render()"]
    end
    
    subgraph Buttons [Botones accion data-x]
        Y["close"] --> Z{"dirty?"}
        Z -->|Si| AA["Confirmar guardar/descartar"]
        Z -->|No| AB["SP.style.display=none"]
        AC["save"] --> AD["ls(aj_cfg,CF) dirty=false"]
        AE["setdef"] --> AF["ls(aj_def,CF) commit()"]
        AG["fact"] --> AH["CF=DF sv() ap() openSet() render()"]
        AI["pnew"] --> AJ["ls(aj_perf, [{n,c:CF}])"]
        AK["ld"] --> AL["CF=DF+preset.c sv() ap() openSet() render()"]
        AM["dl"] --> AN["ls(aj_perf).splice() plHtml()"]
        AO["newg"] --> AP["startVals() SP.hide() nuevo()"]
        AQ["reset"] --> AR["CF=DF+aj_def sv() ap() openSet() render()"]
        AS["exp"] --> AT["$('spj').value=JSON.stringify(CF)"]
        AU["imp"] --> AV["parse JSON merge DF keys sv() ap() render()"]
        AW["clall"] --> AX["CF.sp={} rf()"]
        AY["pb/pp"] --> AZ["Apply preset colors upd()"]
        BA["cp"] --> BB["Copy sprites W->B or B->W rf()"]
        BC["cl"] --> BD["delete CF.sp[key] rf()"]
    end
    
    style Sections fill:#e8f5e9
    style Controls fill:#fff3e0
    style Events fill:#e3f2fd
    style Buttons fill:#fce4ec