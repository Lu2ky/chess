    %% Relationships
    ChessGame *-- MoveLog : "log[]"
    ChessGame *-- Time : "t"
    ChessGame *-- Stats : "st{w,b}"
    ChessGame *-- Move : "last[]"
    ChessGame *-- Move : "ghost"
    ChessGame *-- MoveLog : "mem[]"
    ChessGame --> Engine : "usa"
    ChessGame --> OpeningBook : "consulta"
    ChessGame --> LordAI : "delega análisis"
    ChessGame --> Config : "configura"
    ChessGame --> ProfileEntry : "guarda en perfil"
    ProfileEntry *-- SkillRatings : "sk"
    ProfileEntry *-- LabelCounts : "lb"
    ProfileEntry *-- PiecePerf : "pc"
    LordAI *-- Future : "hf[]"
    Future *-- MoveVariation : "mv[]"
    ChessGame --> ChessGame : "delegar reglas"